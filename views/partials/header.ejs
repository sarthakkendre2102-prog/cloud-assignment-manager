<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Cloud Assignment Manager' : 'Cloud Assignment Manager' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  </style>
</head>
<body>
  <!-- Navigation Header -->
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="brand-link">
        <div class="brand-icon">☁️</div>
        <div class="brand-text">
          <span class="brand-title">CLOUD ASSIGNMENT MANAGER</span>
          <span class="brand-subtitle">Department of Information Technology</span>
        </div>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation menu">
        ☰
      </button>

      <!-- Desktop & Mobile Navigation Links -->
      <nav class="nav-menu" id="navMenu">
        <a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>">
          <span>🏠</span> Home
        </a>
        <a href="/assignments" class="nav-link <%= activePage === 'assignments' ? 'active' : '' %>">
          <span>📚</span> Assignments
        </a>
        <a href="/upload" class="nav-link <%= activePage === 'upload' ? 'active' : '' %>">
          <span>📤</span> Upload Assignment
        </a>
        <a href="/files" class="nav-link <%= activePage === 'files' ? 'active' : '' %>">
          <span>📁</span> Files
        </a>

        <!-- Storage Mode Status Indicator -->
        <div style="margin-left: 0.5rem;">
          <% if (storageMode === 's3') { %>
            <span class="nav-badge-pill pill-s3" title="Cloud Active: Storing in Amazon S3 Bucket: <%= s3Bucket %>">
              <span>☁️</span> AWS S3: <%= s3Bucket %>
            </span>
          <% } else { %>
            <span class="nav-badge-pill pill-local" title="Local Mode: Storing in local uploads/ directory">
              <span>💾</span> Storage: Local Disk
            </span>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <!-- Flash Alerts / Notification Area -->
  <main class="main-wrapper">
    <div id="alertContainer">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
          <div class="alert-content">
            <span class="alert-icon">✅</span>
            <span><%= success %></span>
          </div>
          <button type="button" class="alert-close" aria-label="Close alert">&times;</button>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <div class="alert-content">
            <span class="alert-icon">⚠️</span>
            <span><%= error %></span>
          </div>
          <button type="button" class="alert-close" aria-label="Close alert">&times;</button>
        </div>
      <% } %>
    </div>
