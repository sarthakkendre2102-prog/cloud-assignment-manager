# Server Configuration
PORT=3000

# Storage Configuration: "local" or "s3"
# Use "local" to run completely offline without an AWS account.
# Use "s3" to store uploaded assignment files in an Amazon S3 bucket.
STORAGE_MODE=local

# Amazon S3 Configuration (Required only when STORAGE_MODE=s3)
AWS_REGION=us-east-1
S3_BUCKET=cloud-assignment-manager-bucket-demo

# Optional AWS Credentials for local development with S3
# Note: When running on AWS EC2, leave these commented out to use the attached IAM Role!
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
